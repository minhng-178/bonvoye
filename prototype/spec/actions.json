{
  "schemaVersion": "1.0.0",
  "source": ["ui.js", "engine.js", "src/screens/discovery.js", "src/screens/commerce.js", "src/screens/planner.js"],
  "dispatchPattern": "Widget callback -> actionId + payload -> state transition -> route/render",
  "actions": [
    { "id": "startApp", "category": "navigation", "payload": {}, "sideEffects": [], "failure": "stayOnCurrentScreen" },
    { "id": "selectCity", "category": "selection", "payload": { "cityId": "string" }, "sideEffects": ["updateHomeSelection"] },
    { "id": "selectTopic", "category": "selection", "payload": { "topicId": "string" }, "sideEffects": ["updateHomeSelection"] },
    { "id": "startExploring", "category": "navigation", "payload": {}, "route": "03-permission", "guards": ["citySelected", "topicSelected"] },
    { "id": "answerLocationPermission", "category": "permission", "payload": { "status": "not_asked|while_using|always|denied" }, "sideEffects": ["updatePermissionState", "recomputeProximity"] },
    { "id": "answerGenericPermission", "category": "permission", "payload": { "permission": "string", "status": "granted|denied" } },
    { "id": "openDevPanel", "category": "developer", "payload": {} },
    { "id": "setProximityModel", "category": "developer", "payload": { "modelId": "npc20|poi2535" } },
    { "id": "setFakeGps", "category": "developer", "payload": { "lat": "number", "lng": "number" }, "sideEffects": ["startFakeGpsSession"] },
    { "id": "dragFakeGps", "category": "developer", "payload": { "lat": "number", "lng": "number" }, "guards": ["fakeGpsEnabled", "withinDragLimit"] },
    { "id": "forceFakeGpsReset", "category": "developer", "payload": {}, "sideEffects": ["resetFakeGps"] },
    { "id": "toggleOnline", "category": "offline", "payload": { "online": "boolean" } },
    { "id": "openNearbyPoi", "category": "navigation", "payload": { "poiId": "string" } },
    { "id": "openNpcChooser", "category": "navigation", "payload": { "poiId": "string" }, "guards": ["multipleNpcsInRange"] },
    { "id": "openStory", "category": "story", "payload": { "storyId": "string", "npcId": "string" } },
    { "id": "toggleStoryMode", "category": "story", "payload": { "mode": "audio|webtoon" } },
    { "id": "togglePlayback", "category": "story", "payload": { "playing": "boolean" } },
    { "id": "setScreenOff", "category": "story", "payload": { "screenOff": "boolean" } },
    { "id": "completeStory", "category": "story", "payload": { "storyId": "string" }, "sideEffects": ["persistCompletion"] },
    { "id": "startDownload", "category": "offline", "payload": { "poiId": "string", "package": "full|audio" } },
    { "id": "pauseDownload", "category": "offline", "payload": { "poiId": "string" }, "guards": ["downloadInProgress"] },
    { "id": "resumeDownload", "category": "offline", "payload": { "poiId": "string" }, "guards": ["downloadPaused"] },
    { "id": "claimFreeFirstPoi", "category": "commerce", "payload": { "poiId": "string" }, "guards": ["freeSlotAvailable"] },
    { "id": "openOffers", "category": "navigation", "payload": { "poiId": "string" } },
    { "id": "startPurchase", "category": "commerce", "payload": { "planId": "string" } },
    { "id": "confirmPurchaseSuccess", "category": "commerce", "payload": {} },
    { "id": "confirmPurchaseFailure", "category": "commerce", "payload": { "reason": "string" } },
    { "id": "retryPurchase", "category": "commerce", "payload": { "planId": "string" } },
    { "id": "restorePurchases", "category": "commerce", "payload": {} },
    { "id": "confirmRestoreSuccess", "category": "commerce", "payload": {} },
    { "id": "confirmRestoreEmpty", "category": "commerce", "payload": {} },
    { "id": "submitSearch", "category": "discovery", "payload": { "query": "string" } },
    { "id": "selectFilter", "category": "discovery", "payload": { "filterId": "string" } },
    { "id": "clearSearch", "category": "discovery", "payload": {} },
    { "id": "openPoiDetail", "category": "navigation", "payload": { "poiId": "string" } },
    { "id": "selectTripPoi", "category": "planner", "payload": { "poiId": "string", "selected": "boolean" } },
    { "id": "continueTripPlanner", "category": "planner", "payload": {} },
    { "id": "selectTripDuration", "category": "planner", "payload": { "durationId": "string" } },
    { "id": "selectTravelMode", "category": "planner", "payload": { "modeId": "string" } },
    { "id": "generateTrip", "category": "planner", "payload": { "durationId": "string", "modeId": "string" } },
    { "id": "editTrip", "category": "planner", "payload": {} },
    { "id": "reorderTrip", "category": "planner", "payload": { "from": "number", "to": "number" } },
    { "id": "cancelTripEdit", "category": "planner", "payload": {} },
    { "id": "saveTrip", "category": "planner", "payload": { "tripId": "string" } },
    { "id": "openMap", "category": "navigation", "payload": {} },
    { "id": "openJourney", "category": "navigation", "payload": {} },
    { "id": "goHome", "category": "navigation", "payload": {} },
    { "id": "openSettings", "category": "navigation", "payload": {} },
    { "id": "selectFloor", "category": "story", "payload": { "floorId": "string" } },
    { "id": "redeemPartnerCode", "category": "commerce", "payload": { "code": "string" } }
  ]
}
